{
	"name": "united-colors",
	"version": "1.0.0",
	"private": true,
	"main": "index.ts",
	"packageManager": "pnpm@10.34.6",
	"engines": {
		"node": "24.21.0",
		"pnpm": "10.34.6"
	},
	"scripts": {
		"start": "expo start",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"web": "expo start --web",
		"prebuild:ios": "expo prebuild --platform ios --clean",
		"prebuild:android": "expo prebuild --platform android --clean",
		"prebuild": "expo prebuild --clean",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format .",
		"format:fix": "biome format --write .",
		"doctor:react": "CI=true react-doctor . --blocking warning --no-score",
		"doctor:expo": "EXPO_NO_TELEMETRY=1 expo-doctor",
		"doctors": "pnpm run doctor:react && pnpm run doctor:expo",
		"verify": "biome ci . && pnpm run typecheck && pnpm run test && pnpm run doctors",
		"preflight": "biome check --write . && pnpm run verify",
		"test": "vitest run --config vitest.config.mts"
	},
	"dependencies": {
		"@react-native-async-storage/async-storage": "2.2.0",
		"@shopify/react-native-skia": "2.6.2",
		"expo": "~57.0.27",
		"expo-asset": "~57.0.19",
		"expo-audio": "~57.0.5",
		"expo-build-properties": "~57.0.22",
		"expo-dev-client": "~57.0.19",
		"expo-sensors": "~57.0.3",
		"expo-splash-screen": "~57.0.9",
		"expo-status-bar": "~57.0.1",
		"expo-system-ui": "~57.0.4",
		"react": "19.2.3",
		"react-native": "0.86.3",
		"react-native-reanimated": "4.5.1",
		"react-native-safe-area-context": "~5.7.0",
		"react-native-worklets": "0.10.1",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/react": "~19.2.2",
		"expo-doctor": "1.20.4",
		"react-doctor": "0.9.17",
		"typescript": "~6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.3"
	}
}
