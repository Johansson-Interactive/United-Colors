{
	"name": "tiltling",
	"version": "1.0.0",
	"private": true,
	"main": "index.ts",
	"packageManager": "pnpm@10.34.6",
	"engines": {
		"node": "24.21.0",
		"pnpm": "10.34.6"
	},
	"scripts": {
		"start": "expo start",
		"android": "expo run:android --variant debugOptimized",
		"ios": "expo run:ios",
		"web": "expo start --web",
		"prebuild:ios": "expo prebuild --platform ios --clean",
		"prebuild:android": "expo prebuild --platform android --clean",
		"prebuild": "expo prebuild --clean",
		"build:android": "npx eas-cli@25.3.0 build --platform android --profile production",
		"submit:android": "npx eas-cli@25.3.0 submit --platform android --latest",
		"build:ios": "npx eas-cli@25.3.0 build --platform ios --profile production",
		"submit:ios": "npx eas-cli@25.3.0 submit --platform ios --latest",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format .",
		"format:fix": "biome format --write .",
		"doctor:react": "CI=true react-doctor . --blocking warning --no-score",
		"doctor:expo": "EXPO_NO_TELEMETRY=1 EXPO_DOCTOR_SKIP_DEPENDENCY_VERSION_CHECK=1 expo-doctor",
		"doctor:deps": "scripts/quiet.sh expo-deps env CI=1 EXPO_NO_TELEMETRY=1 expo install --check || echo '⚠ expo-deps: versions drift from the Expo SDK (non-blocking)'",
		"lint:unused": "knip",
		"doctors": "scripts/quiet.sh react-doctor pnpm run doctor:react && scripts/quiet.sh expo-doctor pnpm run doctor:expo && pnpm run --silent doctor:deps",
		"verify": "biome ci . && pnpm run typecheck && pnpm run test && pnpm run lint:unused && pnpm run doctors",
		"preflight": "biome check --write . && pnpm run verify",
		"test": "vitest run --config vitest.config.mts",
		"bench": "vitest bench --run --config vitest.config.mts --reporter=verbose"
	},
	"dependencies": {
		"@react-native-async-storage/async-storage": "2.2.0",
		"@shopify/react-native-skia": "2.6.2",
		"expo": "~57.0.30",
		"expo-application": "~57.0.3",
		"expo-asset": "~57.0.20",
		"expo-audio": "~57.0.5",
		"expo-build-properties": "~57.0.22",
		"expo-dev-client": "~57.0.20",
		"expo-haptics": "~57.0.3",
		"expo-keep-awake": "~57.0.2",
		"expo-sensors": "~57.0.3",
		"expo-splash-screen": "~57.0.10",
		"expo-status-bar": "~57.0.1",
		"expo-system-ui": "~57.0.4",
		"react": "19.2.3",
		"react-native": "0.86.3",
		"react-native-reanimated": "4.5.1",
		"react-native-safe-area-context": "~5.7.0",
		"react-native-worklets": "0.10.1",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/react": "~19.2.2",
		"expo-doctor": "1.20.4",
		"knip": "6.41.0",
		"react-doctor": "0.9.17",
		"typescript": "~6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.3"
	},
	"reanimated": {
		"staticFeatureFlags": {
			"ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
		}
	}
}
