{
	"cli": {
		"version": ">= 25.3.0",
		"appVersionSource": "remote"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal",
			"android": {
				"gradleCommand": ":app:assembleDebugOptimized"
			},
			"ios": {
				"simulator": true
			}
		},
		"preview": {
			"distribution": "internal"
		},
		"probe": {
			"extends": "preview",
			"env": {
				"EXPO_PUBLIC_MOTION_PROBE": "1"
			}
		},
		"production": {
			"autoIncrement": true
		}
	},
	"submit": {
		"production": {
			"ios": {
				"ascAppId": "6825297070"
			},
			"android": {
				"track": "internal"
			}
		},
		"store": {
			"ios": {
				"ascAppId": "6825297070"
			},
			"android": {
				"track": "production",
				"releaseStatus": "draft"
			}
		}
	}
}
