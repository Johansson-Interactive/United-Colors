{
	"cli": {
		"version": ">= 24.12.1",
		"appVersionSource": "remote"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal",
			"android": {
				"gradleCommand": ":app:assembleDebugOptimized"
			},
			"ios": {
				"simulator": true
			}
		},
		"preview": {
			"distribution": "internal"
		},
		"production": {
			"autoIncrement": true
		}
	},
	"submit": {
		"production": {
			"ios": {
				"ascAppId": "6825297070"
			},
			"android": {
				"track": "internal"
			}
		}
	}
}
