{
	"$schema": "./node_modules/knip/schema-jsonc.json",
	// Entry points come from knip's Expo, Vitest, Babel and Metro plugins; .gitignore'd paths are skipped.
	// Knip's Expo plugin expects expo-updates unless app.json opts out; this app doesn't ship OTA updates.
	// Local config plugins are referenced by path from app.json, which knip doesn't follow.
	"entry": ["plugins/*.js"],
	// Babel's preset and core are intentionally resolved through Expo's installed dependencies.
	"ignoreDependencies": ["expo-updates", "babel-preset-expo", "@babel/core"]
}
