{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"plugins": [
		{
			"path": "./biome-plugins/colors-in-theme.grit",
			"includes": [
				"**/src/**",
				"!**/src/presentation/theme/theme.ts",
				"!**/src/domain/constants.ts",
				"!**/src/__tests__/**"
			]
		}
	],
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"domains": {
			"react": "recommended",
			"reactNative": "recommended",
			"types": "recommended"
		},
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedVariables": "warn",
				"noUnusedImports": "warn"
			},
			"style": {
				"noNonNullAssertion": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	},
	"files": {
		"includes": [
			"**",
			"!node_modules",
			"!dist",
			"!coverage",
			"!.expo",
			"!ios",
			"!android",
			"!assets",
			"!.cursor"
		]
	}
}
